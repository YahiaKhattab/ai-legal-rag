# ============================================================
# Qdrant connection — choose ONE block (local OR cloud) at a time.
# Comment out the one you are not using by adding "#" at the start
# of each of its lines.
# ============================================================

# --- LOCAL (offline, Docker on your own machine) ---
LEGAL_RAG_QDRANT_URL=http://localhost:6333
LEGAL_RAG_QDRANT_COLLECTION=legal_chunks

# --- CLOUD (shared team cluster on Qdrant Cloud) ---
# LEGAL_RAG_QDRANT_URL=https://28c98158-e507-4cdf-8649-d19023b918db.eu-central-1-0.aws.cloud.qdrant.io:6333
# LEGAL_RAG_QDRANT_API_KEY=your-cloud-api-key-here
# LEGAL_RAG_QDRANT_COLLECTION=legal_chunks

LEGAL_RAG_OLLAMA_URL=http://localhost:11434
LEGAL_RAG_GENERATION_MODEL=qwen3:4b
LEGAL_RAG_HEALTH_TIMEOUT_SECONDS=5
LEGAL_RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-base
LEGAL_RAG_EMBEDDING_DEVICE=cpu
LEGAL_RAG_RETRIEVAL_TOP_K=20
LEGAL_RAG_RERANK_TOP_N=6
LEGAL_RAG_EVIDENCE_TOP_N=2
LEGAL_RAG_RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
LEGAL_RAG_RERANK_DEVICE=cpu
LEGAL_RAG_GENERATION_TIMEOUT_SECONDS=200
LEGAL_RAG_GENERATION_TEMPERATURE=0.1
LEGAL_RAG_GENERATION_RETRY_COUNT=1
LEGAL_RAG_MAXIMUM_CONTEXT_CHARACTERS=12000

# Experimental smoke-test values. Calibrate before production use.
LEGAL_RAG_EVIDENCE_SUFFICIENCY_ENABLED=true
LEGAL_RAG_EXPERIMENTAL_MIN_DENSE_SCORE=0.82
LEGAL_RAG_EXPERIMENTAL_IDENTIFIER_OVERRIDE_SCORE=0.75
LEGAL_RAG_EXPERIMENTAL_MAX_DENSE_SCORE_DROP=0.02
LEGAL_RAG_EXPERIMENTAL_MIN_RERANK_SCORE=-1.0